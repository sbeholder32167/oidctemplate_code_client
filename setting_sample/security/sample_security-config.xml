<!-- OIDC Template Code 설정 Sample XML (Spring Security 사용 시 - Spring Security 설정만) -->
<beans:beans xmlns="http://www.springframework.org/schema/security"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:beans="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
       http://www.springframework.org/schema/security http://www.springframework.org/schema/security/spring-security-4.2.xsd">

       <!-- Legacy Settings. (Example)-->
       <http pattern="/**/*.js" security="none" />
       <http pattern="/**/*.css" security="none" />
       <http pattern="/**/*.jpg" security="none" />
       <http pattern="/images/*" security="none" />

       <!-- OIDC Logout URL : Back Channel Controller Logout (avoid CSRF defense) -->
       <!-- use Controller Type IDP Logout only.(Optional : Not Filter type.) -->
       <http pattern="/keycloak/logout.do" security="none" />
       
       <http auto-config="true" use-expressions="true">
           <!-- Required: OIDC auth. URL (OIDC Login Filter parameters.)-->
           <intercept-url pattern="/account/oidc.do" access="permitAll" />
           <intercept-url pattern="/account/oidc_code.do" access="permitAll" />
           <!-- Required: OIDC auth. by Controller URL (Optional) -->
           <intercept-url pattern="/keycloak/oidc.do" access="permitAll" />
           <intercept-url pattern="/keycloak/oidc_code.do" access="permitAll" />
           <!-- OIDC Logout URL Front Channel Logout -->
           <!-- <intercept-url pattern="/keycloak/logout.do" access="permitAll" /> -->

           <!-- Legacy (Example)-->
           <intercept-url pattern="/account/login.do" access="permitAll" />
           <intercept-url pattern="/home/notice.do" access="hasRole('ROLE_GUEST')" />
           <intercept-url pattern="/category/remove.do" access="hasRole('ROLE_MANAGER')" />
           <intercept-url pattern="/group/*" access="hasRole('ROLE_MANAGER')" />
           <intercept-url pattern="/**" access="hasRole('ROLE_USER')" />

           <!-- Required: OIDC Filter -->
           <custom-filter ref="OIDCLoginFilter" before="FORM_LOGIN_FILTER" />
           <custom-filter ref="OIDCLogoutFilter" before="LOGOUT_FILTER" />
           <csrf request-matcher-ref="idpLogoutMatcher" disabled="true" />

           <!-- Legacy Login / Logout (Example)-->
           <form-login login-page="/account/login.do" username-parameter="userId" password-parameter="userPw" 
                       login-processing-url="/account/process" default-target-url="/home/notice.do" authentication-failure-url="/account/login.do#loginfailed"
                       always-use-default-target="true" />
           <logout logout-url="/account/logout" invalidate-session="false"
                   success-handler-ref="legacyLogoutHandler" />
       </http>
       <!-- Legacy Settings (Example)-->
       <beans:bean id="legacyLogoutHandler" class="com.example.legacy.LegacyLogoutHandler">
       	   <beans:property name="defaultTargetUrl" value="/account/login.do#logout" />
       </beans:bean>
       <global-method-security pre-post-annotations="enabled" />
       
       <!-- Legacy Authentication Provider Settings (Example)-->
       <beans:bean id="passwordEncoder" class="org.springframework.security.authentication.encoding.ShaPasswordEncoder" >
           <beans:constructor-arg>
               <beans:value>256</beans:value>
           </beans:constructor-arg>
       </beans:bean>
       <beans:bean id="saltSource" class="org.springframework.security.authentication.dao.ReflectionSaltSource">
           <beans:property name="userPropertyToUse" value="userSalt" />
       </beans:bean>
       <beans:bean id="authService" class="com.example.legacy.service.AuthService" />
       <beans:bean id="legacyAuthenticationProvider" class="com.example.legacy.security.LegacyAuthenticationProvider" />

       <!-- Required: Avoid CSRF protection for Inbound BackChannel Logout endpoint. -->
       <bean id="idpLogoutMatcher" class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
           <constructor-arg value="/account/logout.do" /> <!-- Customize Setting -->
       </bean>
       <authentication-manager alias="authenticationManager">
           <authentication-provider ref="legacyAuthenticationProvider" />
           <!-- Required: OIDC Authentication Provider -->
           <authentication-provider ref="OIDCAuthenticationProvider" />
       </authentication-manager>
</beans:beans>